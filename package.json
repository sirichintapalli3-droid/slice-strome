{
  "name": "slice-storm",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run client\"",
    "backend": "python app.py",
    "client": "npm run dev --workspace=client -- --host 0.0.0.0",
    "build": "npm run build --workspace=client",
    "start": "python app.py"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
