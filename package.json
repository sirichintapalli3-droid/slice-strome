{
  "name": "slice-storm",
  "private": true,
  "workspaces": [
    "frontend/client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run client\"",
    "backend": "python -m backend.app",
    "client": "npm run dev --workspace=frontend/client -- --host 0.0.0.0",
    "build": "npm run build --workspace=frontend/client",
    "start": "python -m backend.app"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
